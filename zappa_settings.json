{
  "main": {
    "app_function": "app.app",
    "aws_region": "ap-southeast-1",
    "project_name": "drangue-bot",
    "runtime": "python3.11",
    "s3_bucket": "zappa-drangue-deployments-test",
    "timeout_seconds": 30,
    "memory_size": 256,
    "keep_warm": true,
    "warm_functions": true,
    "slim_handler": true,
    "api_gateway_endpoint": "regional",
    "lambda_handler": "lambda.handler",
    "manage_roles": false,
    "role_name": "ZappaLambdaExecution",
    "cors": true,
    "binary_support": true,

    "environment_variables": {
      "ENV": "production",
      "DEBUG": "False",
      "MONGODB_ATLAS_CLUSTER_URI": "${MONGODB_ATLAS_CLUSTER_URI}",
      "DB_NAME": "${DB_NAME}"
    },
    
    "aws_environment_variables": {
      "PYTHONPATH": "/var/task"
    },

    "vpc_config": {
      "SubnetIds": [],
      "SecurityGroupIds": []
    }
  }
}